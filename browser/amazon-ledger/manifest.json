{
  "manifest_version": 3,
  "name": "Ledger Amazon Orders Sync",
  "version": "0.2.0",
  "description": "Automatically refresh Amazon order details in Ledger while your desktop browser is running.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Amazon order sync for Ledger",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
